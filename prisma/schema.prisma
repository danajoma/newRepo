generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}



model Users {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
  role     String

  admin        Admins?
  supervisor   Supervisors?
  intern       Interns?
}

model Admins {
  id                Int @id
  experience_years  Int

  user Users @relation(fields: [id], references: [id], onDelete: Cascade)

  supervisors Supervisors[]
  interns     Interns[]
  projects    Projects[]
}

model Supervisors {
  id        Int @id
  admin_id  Int?
  company   String

  user Users @relation(fields: [id], references: [id], onDelete: Cascade)

  admin Admins? @relation(fields: [admin_id], references: [id], onDelete: SetNull)

  projects  Projects[]
  feedbacks Feedbacks[]
}

model Interns {
  id                Int @id
  admin_id          Int?
  university        String
  major             String
  attendance_ratio  Int

  user Users @relation(fields: [id], references: [id], onDelete: Cascade)

  admin Admins? @relation(fields: [admin_id], references: [id], onDelete: SetNull)

  tasks      Tasks[]
  feedbacks  Feedbacks[]
}

model Projects {
  id                   Int      @id @default(autoincrement())
  created_by_admin_id  Int
  supervisor_id        Int?
  title                String
  description          String
  start_date           DateTime
  end_date             DateTime

  admin Admins @relation(fields: [created_by_admin_id], references: [id], onDelete: Cascade)

  supervisor Supervisors? @relation(fields: [supervisor_id], references: [id], onDelete: SetNull)

  tasks Tasks[]
}

model Tasks {
  id          Int      @id @default(autoincrement())
  project_id  Int
  intern_id   Int
  title       String
  description String
  status      String
  deadline    DateTime

  project Projects @relation(fields: [project_id], references: [id], onDelete: Cascade)

  intern Interns @relation(fields: [intern_id], references: [id], onDelete: Cascade)

  feedbacks Feedbacks[]
}

model Feedbacks {
  id            Int      @id @default(autoincrement())
  task_id       Int
  intern_id     Int
  supervisor_id Int
  comment       String
  rating        Int
  date          DateTime

  task Tasks @relation(fields: [task_id], references: [id], onDelete: Cascade)

  intern Interns @relation(fields: [intern_id], references: [id], onDelete: Cascade)

  supervisor Supervisors @relation(fields: [supervisor_id], references: [id], onDelete: Cascade)
}